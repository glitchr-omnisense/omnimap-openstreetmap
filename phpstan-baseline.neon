parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset ''user\-agent'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/OpenStreetMapProviderTest.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/OpenStreetMapProviderTest.php

		-
			message: '#^Parameter \#1 \$array of function array_filter expects array, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: Tests/BareTest.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''dirname'' given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/BareTest.php

		-
			message: '#^Parameter \#2 \$array of function preg_grep expects array, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/BareTest.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(mixed\)\: bool\)\|null, Closure\(string\|null\)\: bool given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/BareTest.php

		-
			message: '#^Parameter \#2 \$haystack of static method PHPUnit\\Framework\\Assert\:\:assertContains\(\) expects iterable, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/BareTest.php

		-
			message: '#^Parameter \#1 \$array of function array_values expects array\<T\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/Fixtures/load-all.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''realpath'' given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/Fixtures/load-all.php

		-
			message: '#^Parameter \#1 \$directory of class RecursiveDirectoryIterator constructor expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/Fixtures/load-all.php

		-
			message: '#^Parameter \#1 \$string of function strlen expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/Fixtures/load-all.php
